# Telegram Bot Configuration
BOT_TOKEN=your_token_here

# Database Configuration (PostgreSQL for production)
DATABASE_URL=postgresql+asyncpg://pingme:pingme@postgres:5432/pingme

# PostgreSQL container credentials
POSTGRES_USER=pingme
POSTGRES_PASSWORD=pingme
POSTGRES_DB=pingme

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Application Settings
DEBUG=false
TIMEZONE=Europe/Moscow

# Encryption key for reminder texts (optional but recommended)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REMINDER_ENCRYPTION_KEY=
